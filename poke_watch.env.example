# Copy this file to poke_watch.env (same folder as the script) and fill it in.
# poke_watch.env is in .gitignore: never upload it to GitHub, use repository secrets there.

# The ntfy topic you subscribed to in the phone app. Anyone who knows the name can read it,
# so make it long and random.
NTFY_TOPIC=pick-a-long-random-topic-name

# Optional: your own ntfy server, or an access token if you protected the topic
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Optional: Telegram instead of (or as well as) ntfy
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
